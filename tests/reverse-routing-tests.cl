;;; Load after gate-search-tests.cl and fine-tune-tests.cl. No forecasts or coastline files required.
(in-package :bitsailor)

(defun reverse-test-island-p (origin from to)
  "Intersect the sailed leg with a rectangular island in the local east/north plane."
  (multiple-value-bind (x y) (fine-offset origin from)
    (multiple-value-bind (u v) (fine-offset origin to)
      (let ((lo 0d0) (hi 1d0))
        (loop for a in (list x y) for d in (list (- u x) (- v y))
              for low in '(5500d0 -800d0) for high in '(9500d0 2500d0) do
          (if (< (abs d) 1d-9)
              (unless (<= low a high) (return-from reverse-test-island-p nil))
              (let ((f (/ (- low a) d)) (g (/ (- high a) d)))
                (setf lo (max lo (min f g)) hi (min hi (max f g))))))
        (<= lo hi)))))

(defun reverse-test-passage (percent &key island (distance 15000d0) (duration 4800) missing dateline switch (stepper :hires))
  (call-with-fine-test
   (lambda (routing)
     (let* ((*max-iso-points* 360) (*fine-tune-enabled* nil) (*tracks* nil)
            (start (if dateline (make-latlng :lat 0d0 :lng 179.95d0) (routing-start routing))) (dest (add-distance-exact start distance 90d0))
            (blocked (if island (lambda (a b) (reverse-test-island-p start a b)) (constantly nil))))
       (setf (routing-start routing) start (routing-dest routing) dest (routing-box routing) (make-routing-box start dest)
             (routing-stepper routing) stepper (routing-stepmax routing) duration
             (routing-twa-angles routing)
             (coerce (append (loop for a from 0 to 180 by 5 collect (float a 1d0)) '(0d0 0d0))
                     '(simple-array double-float (*)))
             (routing-reverse-percent routing) percent)
       (when switch
         (setf (routing-secondary-forecast-model routing) 'cl-weather::ecmwf-ifs-wind
               (routing-forecast-switch-time routing) (routing-time+ (routing-starttime routing) 1260)))
       (call-with-gate-test-functions
        (list (cons 'approach-blocked-p blocked)
              (cons 'cl-weather::get-params-for-cycle
                    (lambda (source time &key cycle)
                      (when missing (error "Missing fixture cycle"))
                      (assert (timestamp= (cl-weather:cycle-timestamp cycle) (routing-starttime routing)))
                      (get-params source time)))
              (cons 'filter-isochrone
                    (lambda (v &rest keys) (declare (ignore keys))
                      (remove-if (lambda (p) (or (null p) (funcall blocked (routepoint-position (routepoint-predecessor p))
                                                                   (routepoint-position p)))) v))))
        (lambda ()
          (let* ((info (get-route routing)) (report (routeinfo-reverse-routing info)))
            (when (reverse-result-baseline report)
              (assert (< (fine-distance dest (trackpoint-position (car (last (routeinfo-best info))))) 0.01d0)))
            (values info start))))))))

(defun reverse-test-passages (info origin)
  "Return the two sides visible abreast of the island; every displayed edge must clear land."
  (let ((sides nil))
    (loop for line across (reverse-result-overlap (routeinfo-reverse-routing info)) do
      (loop for (a b) on (isochrone-path line) do
        (when b (assert (not (reverse-test-island-p origin a b))))
        (multiple-value-bind (x y) (fine-offset origin a)
          (when (< 5600 x 9400) (pushnew (if (plusp y) :north :south) sides)))))
    sides))

(defun test-reverse-routing ()
  (assert (null (parse-reverse-options nil nil)))
  (assert (= 2 (parse-reverse-options "true" nil)))
  (assert (zerop (parse-reverse-options "true" "0")))
  (assert (= 0.01d0 (parse-reverse-options "true" "1e-2")))
  (dolist (target (list (make-latlng) (make-gate)))
    (assert (handler-case
                (progn (route-with-reverse-search (make-routing :reverse-percent 1 :waypoints (list target))) nil)
              (error (e) (search "without waypoints" (princ-to-string e))))))
  (dolist (invalid '("-1" "NaN" "1.2.3" "1x" "#.1"))
    (assert (handler-case (progn (parse-reverse-options "true" invalid) nil) (request-error () t))))
  (let* ((zero (reverse-test-passage 0d0)) (loose (reverse-test-passage 1d0))
         (report (routeinfo-reverse-routing loose)) (eta (reverse-result-baseline report)))
    (assert (string= "complete" (reverse-result-status report)))
    (assert (< (abs (- 3000 (timestamp-difference eta (routestats-start (routeinfo-stats loose))))) 0.1d0))
    (assert (< (abs (- 30 (timestamp-difference (reverse-result-deadline report) eta))) 0.01d0))
    (assert (timestamp= (reverse-result-deadline (routeinfo-reverse-routing zero)) eta))
    (let ((contacts (reverse-result-overlap (routeinfo-reverse-routing zero))))
      (assert (plusp (length contacts)))
      (assert (some (lambda (line)
                      (some (lambda (p) (< (abs (latlng-lat p)) 1d-5)) (isochrone-path line)))
                    contacts)))
    (assert (plusp (length (reverse-result-overlap report))))
    (loop for line across (reverse-result-overlap report) do
      (assert (find (isochrone-time line) (routeinfo-isochrones loose) :key #'isochrone-time :test #'timestamp=))))
  (dolist (case '((:missing t) (:duration 120) (:distance 500d0 :stepper :standard)))
    (let* ((r (apply #'reverse-test-passage 1d0 case)) (report (routeinfo-reverse-routing r)))
      (assert (routeinfo-best r))
      (assert (string= (reverse-result-status report)
                       (case (first case) (:missing "forecast-unavailable") (:duration "forward-unreached")
                             (t "complete"))))))
  (dolist (allowance '(2d0 15d0))
    (multiple-value-bind (result start) (reverse-test-passage allowance :island t)
      (let ((sides (reverse-test-passages result start)))
        (format t "~&Island ~A%: ~A ~A~%" allowance (reverse-result-status (routeinfo-reverse-routing result)) sides)
        (assert (member :south sides))
        (assert (eq (not (null (member :north sides))) (> allowance 2d0))))))
  (let* ((r (reverse-test-passage 1d0 :dateline t :switch t))
         (rev (routeinfo-reverse-routing r)))
    (assert (string= "complete" (reverse-result-status rev)))
    (assert (plusp (length (reverse-result-overlap rev))))
    (assert (= (length (remove-duplicates (map 'list #'isochrone-forecast-model
                                               (reverse-result-isochrones rev)))) 2)))
  (test-reverse-tide)
  (test-reverse-display-radial-gap)
  (format t "~&Reverse routing tests passed.~%"))

(defun test-reverse-tide ()
  "Late westward flow closes the finish; an earlier eastward flow and following waves reopen it."
  (call-with-fine-test
   (lambda (routing)
     (let* ((time (routing-starttime routing)) (origin (routing-start routing))
            (grid (cl-weather::make-gribinfo :lat-start 1d0 :lat-end -1d0 :lat-points 3
                       :lon-start 0d0 :lon-end 360d0 :lon-points 361 :i-inc 1d0 :j-inc 1d0))
            (mid (routing-time+ time 60)) (end (routing-time+ mid 60))
            (early (make-reverse-slice :start time :end mid)) (late (make-reverse-slice :start mid :end end)))
       (setf (routing-box routing) (make-routing-box origin (routing-dest routing))
             (routing-twa-angles routing) (make-array 3 :element-type 'double-float :initial-contents '(90d0 0d0 0d0)))
       (labels ((field (value) (make-array 1083 :element-type 'double-float :initial-element value))
                (params (value) (cl-weather::make-params :fc0 value :fc1 value))
                (scalar (value) (params (cl-weather::make-gribmessage :info grid :data (field value))))
                (weather (u sample-time)
                  (list (fine-test-weather time sample-time grid t)
                        (params (cl-weather::make-uv :cycle time :info grid :u-array (field u) :v-array (field 0d0)))
                        (scalar 4d0) (scalar 270d0))))
         (let* ((ebb (weather -12d0 mid)) (flood (weather 1d0 time))
                (empty (reverse-front-step routing #() late ebb))
                (front (reverse-front-step routing empty early flood))
                (finish (routing-dest routing))
                (p (nth-value 1 (fine-sail-step routing finish time -60d0 90d0 :weather flood))))
           (assert (notany #'identity empty))
           (assert (some #'identity front))
           (assert (< (abs (- (fine-distance finish p) 390d0)) 0.1d0))
           (assert (< (fine-distance finish (nth-value 1 (fine-sail-step routing p time 60d0 90d0 :weather flood)))
                      0.1d0))))))))

(defun test-reverse-display-radial-gap ()
  "Separate an old outer front from nearby finish seeds in adjacent buckets."
  (call-with-fine-test
   (lambda (routing)
     (let* ((*max-iso-points* 360) (dest (routing-dest routing))
            (front (make-array 360 :initial-element nil))
            (slice (make-reverse-slice :start (routing-starttime routing)
                                      :cycle (routing-starttime routing))))
       (loop for i from 270 to 273
             for distance in '(100000d0 100000d0 1000d0 1000d0)
             do (setf (aref front i) (add-distance-exact dest distance (float i 1d0))))
       (multiple-value-bind (paths overlap) (reverse-display-paths routing front nil slice 1000d0)
         (assert (= 2 (length paths)))
         (assert (every (lambda (line) (= 2 (length (isochrone-path line)))) paths))
         (assert (null overlap)))))))
