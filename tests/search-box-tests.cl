;;; Load after Bitsailor and gate-search-tests.cl, then call TEST-SEARCH-BOX.
(in-package :bitsailor)

(defun test-search-box ()
  "Check padded arc bounds, wrap/pole cases, disabled clipping and API defaults."
  (flet ((pos (lat lon) (make-latlng :lat (float lat 1d0) :lng (float lon 1d0))))
    (let* ((start (pos 0 0)) (dest (pos 0 100))
           (box (make-routing-box start dest)))
      ;; A long east/west route gains transverse room without becoming square.
      (assert (< (abs (- (box-north box) 20d0)) 1d-8))
      (assert (< (- (box-north box) (box-south box))
                 (- (box-east box) (box-west box))))
      (assert (in-latlng-box box (pos 19 50)))
      (assert (not (in-latlng-box box (pos 21 50))))
      (assert (in-latlng-box nil (pos -89 -170))))
    (let ((box (make-routing-box (pos -50 0) (pos 50 0))))
      (assert (in-latlng-box box (pos 0 19)))
      (assert (not (in-latlng-box box (pos 0 21)))))
    ;; Equal endpoint latitudes can have a large great-circle bulge.
    (let ((box (make-routing-box (pos 60 -80) (pos 60 80))))
      (assert (in-latlng-box box (pos 84 0)))
      (assert (box-all-longitudes box)))
    (let ((box (make-routing-box (pos 0 170) (pos 0 -170)
                                 :lat-margin 2d0 :lon-margin 3d0)))
      (assert (box-antimed-p box))
      (dolist (lon '(167d0 179d0 -179d0 -167d0))
        (assert (in-latlng-box box (pos 0 lon))))
      (assert (not (in-latlng-box box (pos 0 0)))))
    (let ((box (make-routing-box (pos 20 30) (pos 20 30))))
      (assert (in-latlng-box box (pos 20 30))))
    (assert (box-all-longitudes (make-routing-box (pos 0 0) (pos 0 180))))
    (call-with-gate-test-functions
     (list (cons 'get-combined-polars
                 (lambda (&rest args) (declare (ignore args))
                   (make-cpolars :twa #(40d0 90d0 150d0)))))
     (lambda ()
       (let ((enabled (get-routing-presets :polars-id "test" :slat 0d0 :slon 0d0 :dlat 1d0 :dlon 1d0))
             (disabled (get-routing-presets :polars-id "test" :use-box nil :slat 0d0 :slon 0d0 :dlat 1d0 :dlon 1d0)))
         (assert (routing-use-box enabled))
         (assert (box-p (routing-box enabled)))
         (assert (null (routing-box disabled)))
         (assert (null (routing-use-box (copy-routing disabled)))))))
    (let ((seen nil))
      (call-with-gate-test-functions
       (list (cons 'get-routing-presets
                   (lambda (&rest args)
                     (push (getf args :use-box) seen)
                     (error 'request-error :message "selection captured"))))
       (lambda ()
         (dolist (arguments '(nil (:|search_box| "false") (:|search_box| "true")))
           (let* ((request (make-instance 'polarcl::http-basic))
                  (response (make-instance 'polarcl::http-response :request request :status-code 200 :status-text "OK")))
             (apply #'|getRoute| nil request response :|polarsId| "test" :|options| "hull" arguments)))
         (assert (equal '(t nil t) seen))))))
  (format t "~&Search-box bounds, disabled clipping and API selection tests passed.~%"))
