;;; Load after Bitsailor and gate-search-tests.cl, then call TEST-WAVE-ACCESS.
(in-package :bitsailor)

(defun test-wave-access ()
  "Check real frame selection and guard all wave consumers without weather downloads."
  (let* ((base (parse-datetime "2026-11-15T00:00:00Z"))
         (cycle (cl-weather::make-cycle% :timestamp base))
         (previous (cl-weather:previous-cycle 'cl-weather:gfswave-combined cycle))
         (source (make-instance 'cl-weather:gfswave-combined :cycle cycle))
         (routing (make-routing :use-waves t))
         (*routing-wave-state* (make-hash-table :test #'equal))
         (calls nil)
         (missing nil))
    (flet ((at (hours) (routing-time+ base (* 3600 hours))))
      (assert (= 240 (cl-weather::maxstep source)))
      (dolist (pair '((5 6) (6 6) (8 6) (9 9) (119 117) (120 120)
                      (125 120) (126 126) (239 234) (240 240)))
        (assert (= (second pair) (cl-weather::cycle-forecast source (at (first pair))))))
      (dolist (pair '((6 9) (117 120) (120 126) (234 240) (240 240)))
        (assert (= (second pair) (cl-weather::next-forecast source (first pair)))))
      (call-with-gate-test-functions
       (list
        (cons 'cl-weather::timestamp-cycle (lambda (source time)
                                            (declare (ignore source time)) cycle))
        (cons 'cl-weather::get-params-for-cycle
              (lambda (source time &key cycle)
                (declare (ignore source))
                (push (list :height time cycle) calls)
                (when (and missing (timestamp= base (cl-weather:cycle-timestamp cycle)))
                  (error 'cl-weather::missing-forecast))
                :height))
        (cons 'cl-weather::get-direction-params-for-cycle
              (lambda (source time &key cycle)
                (declare (ignore source)) (push (list :direction time cycle) calls) :direction))
        (cons 'routing-wind-params (lambda (&rest args) (declare (ignore args)) :wind)))
       (lambda ()
         ;; A four-day route now uses real wave frames instead of holding hour 48.
         (assert (equal '(:height :direction)
                        (multiple-value-list (routing-wave-params routing (at 96)))))
         (assert (= 2 (length calls)))
         (setf calls nil)
         (routing-wave-params routing (at 240))
         (assert (= 2 (length calls)))
         (setf calls nil)
         (dolist (hour '(241 246 270 241))
           (assert (equal '(nil nil) (multiple-value-list (routing-wave-params routing (at hour))))))
         (assert (null calls))
         (assert (gethash :warned *routing-wave-state*))
         ;; Replays can revisit valid earlier weather after passing the horizon.
         (routing-wave-params routing (at 96))
         (assert (= 2 (length calls)))
         (setf calls nil)
         (let ((*fine-tune-weather* (make-hash-table :test #'equal)))
           (assert (equal '(:wind nil nil nil) (fine-weather routing (at 250)))))
         (reverse-weather routing (at 250) (list nil nil base base))
         (assert (null calls))
         ;; Disabled waves still produce a four-element weather tuple.
         (setf (routing-use-waves routing) nil)
         (let ((*fine-tune-weather* (make-hash-table :test #'equal)))
           (assert (equal '(:wind nil nil nil) (fine-weather routing (at 20)))))
         (assert (null calls))
         (setf (routing-use-waves routing) t missing t)
         (clrhash *routing-wave-state*)
         (routing-wave-params routing (at 96))
         (assert (= 3 (length calls)))
         (assert (every (lambda (call)
                          (timestamp= (cl-weather:cycle-timestamp previous)
                                      (cl-weather:cycle-timestamp (third call))))
                        (subseq calls 0 2)))
         ;; The previous cycle expires a day earlier. Do not clamp it either.
         (setf calls nil)
         (routing-wave-params routing (at 217))
         (assert (null calls))
         (routing-wave-params routing (at 96))
         (assert (= 2 (length calls)))))))
  (format t "~&Wave frame schedule, horizon, replay and cycle fallback tests passed.~%"))
