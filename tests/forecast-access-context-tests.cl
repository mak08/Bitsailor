;;; Load after Bitsailor and gate-search-tests.cl, then call TEST-FORECAST-ACCESS-CONTEXT.
(in-package :bitsailor)

(defun test-forecast-access-context ()
  "Check the context spans routing and tuning, is renewed per request and unwinds on failure."
  (let* ((routing (make-routing :starttime "2026-11-20T12:00" :fine-tune t))
         (outer cl-weather::*forecast-access-context*)
         (seen nil) (fail nil))
    (flet ((observe (&rest args)
             (declare (ignore args))
             (assert (hash-table-p cl-weather::*forecast-access-context*))
             (assert (not (eq outer cl-weather::*forecast-access-context*)))
             (push cl-weather::*forecast-access-context* seen)
             (when fail (error "Synthetic routing failure"))
             :route))
      (call-with-gate-test-functions
       (list (cons 'get-route-leg #'observe) (cons 'get-route-via-waypoints #'observe)
             (cons 'fine-tune-route #'observe) (cons 'route-with-reverse-search #'observe))
       (lambda ()
         (get-route routing)
         (assert (= 2 (length seen)))
         (assert (eq (first seen) (second seen)))
         (let ((first-request (first seen)))
           (setf seen nil)
           (get-route routing)
           (assert (eq (first seen) (second seen)))
           (assert (not (eq first-request (first seen)))))
         (setf seen nil (routing-waypoints routing) '(mark))
         (get-route routing)
         (assert (= 2 (length seen)))
         (assert (eq (first seen) (second seen)))
         (setf seen nil (routing-waypoints routing) nil (routing-reverse-percent routing) 2)
         (get-route routing)
         (assert (= 1 (length seen)))
         (setf fail t)
         (handler-case (get-route routing) (error () nil))
         (assert (eq outer cl-weather::*forecast-access-context*)))))
    (assert (eq outer cl-weather::*forecast-access-context*)))
  (format t "~&Routing forecast context scope, request isolation and failure cleanup passed.~%"))
