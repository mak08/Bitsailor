;;; Load after Bitsailor and gate-search-tests.cl, then call TEST-FORECAST-CONTRACT.
(in-package :bitsailor)

;;; Verify explicit/default cycle forwarding, actual fallback cycle and metadata propagation.
(defun test-forecast-contract ()
  (let* ((time (parse-datetime "2026-10-31T15:00:00Z"))
         (cycle (parse-routing-cycle "2026-10-31T12%3A00%3A00.000Z" 'cl-weather:noaa-gfs-wind))
         (previous (cl-weather::previous-cycle 'cl-weather:noaa-gfs-wind cycle))
         (calls nil)
         (routing (make-routing :forecast-model 'cl-weather:noaa-gfs-wind :cycle cycle)))
    (call-with-gate-test-functions
     (list (cons 'cl-weather::get-params-for-cycle
                 (lambda (model timestamp &key cycle)
                   (declare (ignore model timestamp))
                   (push (cl-weather::cycle-timestamp cycle) calls)
                   (if (timestamp= (cl-weather::cycle-timestamp cycle)
                                   (cl-weather::cycle-timestamp previous))
                       (cl-weather::make-params :fc1 (cl-weather::make-uv :cycle (cl-weather::cycle-timestamp cycle)))
                       (error 'cl-weather::missing-forecast)))))
     (lambda ()
       (let ((params (routing-wind-params routing time)))
         (assert (timestamp= (cl-weather::uv-cycle (cl-weather::params-fc1 params))
                             (cl-weather::cycle-timestamp previous)))
         (assert (= 2 (length calls))))))
    (let ((supplied nil))
      (call-with-gate-test-functions
       (list (cons 'get-params (lambda (model timestamp &rest options)
                                 (declare (ignore model timestamp)) (setf supplied options))))
       (lambda ()
         (routing-wind-params routing time)
         (assert (eq cycle (getf supplied :cycle)))
         (setf (routing-cycle routing) nil)
         (routing-wind-params routing time)
         (assert (null supplied)))))
    (let* ((rp (create-routepoint nil (make-latlng :lat 1d0 :lng 1d0) time nil nil))
           (iso (make-isochrone :path (vector rp rp) :time time :wind-time time
                  :cycle (cl-weather::cycle-timestamp previous) :forecast-model 'cl-weather:noaa-gfs-wind)))
      (dolist (fragment (prepare-routepoints (list iso)))
        (assert (timestamp= time (isochrone-time fragment)))
        (assert (timestamp= time (isochrone-wind-time fragment)))
        (assert (timestamp= (cl-weather::cycle-timestamp previous) (isochrone-cycle fragment)))
        (assert (eq 'cl-weather:noaa-gfs-wind (isochrone-forecast-model fragment))))))
  (handler-case (progn (parse-routing-cycle "2026-10-31T13:00:00Z" 'cl-weather:noaa-gfs-wind)
                       (error "Invalid cycle accepted"))
    (request-error () t))
  (format t "~&Forecast cycle forwarding, fallback provenance and metadata tests passed.~%"))

(defun test-secondary-forecast ()
  (let* ((start (parse-datetime "2026-10-31T15:14:00Z"))
         (switch (adjust-timestamp start (:offset :hour 6)))
         (routing (make-routing :starttime start :forecast-model 'cl-weather:noaa-gfs-wind
                    :secondary-forecast-model 'cl-weather::ecmwf-ifs-wind
                    :forecast-switch-time switch)))
    (assert (eq (routing-model-at routing (adjust-timestamp switch (:offset :sec -1)))
                'cl-weather:noaa-gfs-wind))
    (assert (eq (routing-model-at routing switch) 'cl-weather::ecmwf-ifs-wind))
    (let ((leg (copy-routing routing)))
      (setf (routing-starttime leg) (adjust-timestamp start (:offset :hour 5)))
      (assert (eq (routing-model-at leg switch) 'cl-weather::ecmwf-ifs-wind)))
    (call-with-gate-test-functions
      (list (cons 'get-params (lambda (model time &rest options)
                               (declare (ignore time))
                               (assert (eq model 'cl-weather::ecmwf-ifs-wind))
                               (assert (null options)))))
      (lambda ()
        (setf (routing-cycle routing) :primary-cycle)
        (routing-wind-params routing switch)))
    (let ((stepper (make-stepper start (* 48 3600) switch)) (time start))
      (loop while (timestamp< time switch)
            do (setf time (adjust-timestamp time (:offset :sec (funcall stepper)))))
      (assert (timestamp= time switch)))
    (setf (routing-forecast-switch-time routing) nil)
    (assert (eq (routing-model-at routing switch) 'cl-weather:noaa-gfs-wind)))
  (dolist (hours '("6" "12" "24"))
    (assert (= (parse-integer hours) (parse-forecast-switch-hours hours)))
    (assert (eq 'cl-weather::ecmwf-ifs-wind (parse-secondary-model "ECMWF-IFS-WIND" hours))))
  (assert (null (parse-forecast-switch-hours "off")))
  (dolist (hours '("0" "7" "bad"))
    (assert (handler-case (progn (parse-forecast-switch-hours hours) nil) (request-error () t))))
  (assert (handler-case (progn (parse-secondary-model "INVALID" "6") nil) (request-error () t)))
  (format t "~&Secondary forecast boundary, leg continuity, cycles and validation tests passed.~%"))
