;;; Load after Bitsailor, then call TEST-ROUTING-STEPPERS.
(in-package :bitsailor)

;;; Collect advancing steps, including fractional alignment remainders.
(defun test-stepper-samples (stepper start end)
  (let ((time start) (result nil))
    (loop while (timestamp< time end) do
      (multiple-value-bind (dt next) (funcall stepper)
        (assert (and (realp dt) (plusp dt)))
        (assert (timestamp= next (routing-time+ time dt)))
        (push (cons dt next) result)
        (setf time next)))
    (nreverse result)))

;;; Hires must sample each minute initially, then exactly rejoin the standard
;;; schedule, preserving source switches and the departure of multi-leg routes.
(defun test-routing-steppers ()
  (dolist (departure '("2026-11-04T20:09:00Z" "2026-11-04T20:09:17.500Z"))
    (let* ((start (local-time:parse-timestring departure))
           (cutoff (routing-minute-ceiling (adjust-timestamp start (:offset :hour 8))))
           (end (adjust-timestamp start (:offset :hour 25))))
      (dolist (switch-offset '(nil 21600 21307 43323))
        (let* ((switch (when switch-offset (adjust-timestamp start (:offset :sec switch-offset))))
               (standard (test-stepper-samples (make-stepper (routing-minute-ceiling start) 172800
                                          (when switch (routing-minute-ceiling switch)))
                                            (routing-minute-ceiling start) end))
               (hires (test-stepper-samples (make-hires-stepper start 172800 switch) start end))
               (early (remove-if (lambda (p) (timestamp> (cdr p) cutoff)) hires))
               (standard-tail (remove-if-not (lambda (p) (timestamp> (cdr p) cutoff)) standard))
               (hires-tail (remove-if-not (lambda (p) (timestamp> (cdr p) cutoff)) hires)))
          (assert (timestamp= (cdr (car (last early))) cutoff))
          (assert (every (lambda (p) (<= (car p) 60)) early))
          (assert (every (lambda (p) (routing-minute-p (cdr p))) hires))
          (when (routing-minute-p start) (assert (= 480 (length early)))
            (assert (every (lambda (p) (= 60 (car p))) early)))
          (when (and switch (timestamp> switch cutoff))
            (assert (find (routing-minute-ceiling switch) hires :test #'timestamp= :key #'cdr)))
          (assert (= (length standard-tail) (length hires-tail)))
          (assert (every #'timestamp= (mapcar #'cdr standard-tail) (mapcar #'cdr hires-tail)))))))
  (let* ((origin (parse-datetime "2026-11-04T20:09:00Z"))
         (start (adjust-timestamp origin (:offset :hour 7)))
         (routing (make-routing :starttime start :stepper-starttime origin :stepper :hires :stepmax 86400))
         (stepper (make-routing-stepper (copy-routing routing) start)))
    ;; A later leg gets only the remaining hour of high resolution.
    (dotimes (i 60) (assert (= 60 (funcall stepper))))
    (let ((after (nth-value 1 (funcall stepper))))
      (assert (timestamp> after (adjust-timestamp origin (:offset :hour 8)))))
    (setf (routing-starttime routing) (adjust-timestamp origin (:offset :hour 9)))
    (let ((standard (make-stepper (routing-starttime routing) 86400 nil origin))
          (hires (make-routing-stepper routing (routing-starttime routing))))
      (dotimes (i 30)
        (multiple-value-bind (a ta) (funcall standard)
          (multiple-value-bind (b tb) (funcall hires)
            (assert (= a b)) (assert (timestamp= ta tb)))))))
  ;; Every departure minute and both short/long horizons must stop fine steps
  ;; by two hours, without moving the existing later horizon thresholds.
  (dotimes (minute 60)
    (dolist (duration '(14400 86400))
      (let* ((start (adjust-timestamp (parse-datetime "2026-11-05T20:00:00Z") (:offset :minute minute)))
             (cutoff (adjust-timestamp start (:offset :hour 2)))
             (stepper (make-stepper start duration)) (time start) (firstp t) (coarse nil))
        (loop while (timestamp< time (adjust-timestamp cutoff (:offset :hour 1))) do
          (multiple-value-bind (dt next) (funcall stepper)
            (unless firstp
              (when (= dt 120) (assert (timestamp<= next cutoff)) (assert (not coarse)))
              (when (= dt 600)
                (unless coarse (assert (timestamp<= time cutoff)))
                (setf coarse t)
                (assert (zerop (mod (timestamp-to-unix time) 600)))))
            (setf time next firstp nil)))
        (assert coarse))))
  ;; Later point-waypoint legs do not restart the request's two-minute phase.
  (let* ((origin (parse-datetime "2026-11-05T20:00:00Z"))
         (start (adjust-timestamp origin (:offset :hour 3)))
         (routing (make-routing :starttime start :stepper-starttime origin :stepmax 86400))
         (stepper (make-routing-stepper routing start)))
    (dotimes (i 10) (assert (= 600 (funcall stepper)))))
  (dolist (value '(nil "" "standard" "STANDARD")) (assert (eq :standard (parse-routing-stepper value))))
  (assert (eq :hires (parse-routing-stepper "hires")))
  (assert (handler-case (progn (parse-routing-stepper "invalid") nil) (request-error () t)))
  (format t "~&Standard/hires stepping, eight-hour cutoff, switches, later legs and validation passed.~%"))
