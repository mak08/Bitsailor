;;; Load after Bitsailor and gate-search-tests.cl, then call TEST-FINE-TUNING-SELECTION.
(in-package :bitsailor)

(defun test-fine-tuning-selection ()
  "Verify default-off API/UI contract, request-local dispatch and disabled reports."
  (let* ((start (make-latlng :lat 0d0 :lng 0d0))
         (dest (make-latlng :lat 1d0 :lng 1d0))
         (routing (make-routing :start start :dest dest :starttime "2026-11-19T12:00"))
         (seen nil)
         (*fine-tune-enabled* t))
    (flet ((observe (&rest args) (declare (ignore args)) (push *fine-tune-enabled* seen) :info))
      (call-with-gate-test-functions
       (list (cons 'get-route-leg #'observe) (cons 'get-route-via-waypoints #'observe)
             (cons 'fine-tune-route #'observe) (cons 'route-with-reverse-search #'observe))
       (lambda ()
         (assert (null (routing-fine-tune routing)))
         (get-route routing)
         (assert (equal '(nil nil) seen))
         (assert *fine-tune-enabled*)
         (setf seen nil (routing-fine-tune routing) t)
         (get-route routing)
         (assert (equal '(t t) seen))
         (setf seen nil (routing-waypoints routing) (list dest))
         (get-route routing)
         (assert (equal '(t t) seen))
         (setf seen nil (routing-waypoints routing) nil (routing-reverse-percent routing) 2)
         (get-route routing)
         (assert (equal '(t) seen))
         (assert (routing-fine-tune (copy-routing routing)))
         (let ((*fine-tune-enabled* nil))
           (setf seen nil)
           (get-route routing)
           (assert (equal '(nil) seen))))))
    (call-with-gate-test-functions
     (list (cons 'get-combined-polars (lambda (&rest args) (declare (ignore args))
                                      (make-cpolars :twa #(40d0 90d0 150d0)))))
     (lambda ()
       (assert (null (routing-fine-tune (get-routing-presets :polars-id "test" :slat 0d0 :slon 0d0 :dlat 1d0 :dlon 1d0))))
       (assert (routing-fine-tune (get-routing-presets :polars-id "test" :fine-tune t :slat 0d0 :slon 0d0 :dlat 1d0 :dlon 1d0)))))
    ;; Exercise the actual HTTP parser, stopping before map/weather initialization.
    (call-with-gate-test-functions
     (list (cons 'get-routing-presets
                 (lambda (&rest args)
                   (push (getf args :fine-tune) seen)
                   (error 'request-error :message "selection captured"))))
     (lambda ()
       (setf seen nil)
       (dolist (arguments '(nil (:|fine_tune| "false") (:|fine_tune| "true")))
         (let* ((request (make-instance 'polarcl::http-basic))
                (response (make-instance 'polarcl::http-response :request request :status-code 200 :status-text "OK")))
           (apply #'|getRoute| nil request response :|polarsId| "test" :|options| "hull" arguments)))
       (assert (equal '(t nil nil) seen))))
    ;; Disabled tuning still produces display/export metadata without any trials.
    (let* ((*fine-tune-enabled* nil)
           (time (parse-datetime "2026-11-19T12:00:00Z"))
           (track (list (make-trackpoint :time time :position start :twa 145d0 :heading 180d0 :tws 10d0)
                        (make-trackpoint :time (routing-time+ time 600) :position dest :tws 10d0)))
           (info (make-routeinfo :status "max_duration" :best track
                                :stats (get-statistics track 1d0 1 10))))
      (fine-tune-route routing info)
      (assert (string= "disabled" (fine-tuning-reason (routeinfo-fine-tuning info))))
      (assert (zerop (fine-tuning-evaluations (routeinfo-fine-tuning info))))
      (assert (eq track (routeinfo-best info)))))
  (format t "~&Fine-tuning default, API selection, request isolation and disabled report tests passed.~%"))
